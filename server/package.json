{
  "name": "clinic-app-server",
  "version": "1.0.0",
  "private": true,
  "description": "Clinic Management System - Backend API",
  "main": "dist/index.js",
  "scripts": {
    "ensure-env": "node scripts/ensure-env.js",
    "dev": "npm run ensure-env && tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "seed": "tsx prisma/seed.ts",
    "setup": "npm run ensure-env && prisma generate && prisma db push && tsx prisma/seed.ts",
    "prisma:pg:generate": "prisma generate --schema prisma/schema.postgres.prisma",
    "prisma:pg:push": "prisma db push --schema prisma/schema.postgres.prisma",
    "prisma:pg:sql": "node scripts/gen-supabase-sql.js",
    "setup:supabase": "prisma generate --schema prisma/schema.postgres.prisma && prisma db push --schema prisma/schema.postgres.prisma && tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "pdfkit": "^0.15.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.9.0",
    "@types/pdfkit": "^0.13.5",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
