# ─────────────────────────────────────────────────────────────
# Local development (SQLite) — the default, zero-setup option
# ─────────────────────────────────────────────────────────────
DATABASE_URL="file:./dev.db"

# ─────────────────────────────────────────────────────────────
# Production on Supabase (PostgreSQL) — see SUPABASE.md
# Uncomment these and comment out the SQLite line above.
# Get both strings from: Supabase → Project Settings → Database → Connection string
#
#   DATABASE_URL  = the "Transaction" pooler URL (port 6543) + ?pgbouncer=true
#   DIRECT_URL    = the "Session"/direct URL (port 5432), used for migrations
# ─────────────────────────────────────────────────────────────
# DATABASE_URL="postgresql://postgres.xxxx:[PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.xxxx:[PASSWORD]@aws-0-region.pooler.supabase.com:5432/postgres"

JWT_SECRET="change-this-in-production-super-secret-key"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
